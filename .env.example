# Bắt buộc: điền OpenAI API key của bạn vào đây
OPENAI_API_KEY=sk-...

# Tùy chọn: đổi nếu bạn dùng endpoint tương thích OpenAI (proxy / OpenRouter / ...)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model phân tích khung hình video & viết kịch bản
# Khuyên dùng: gpt-4o (chất lượng cao) hoặc gpt-4o-mini (rẻ, nhanh để test)
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_DIRECTOR_MODEL=gpt-4o

# Giọng đọc (TTS): "openai" (dùng chung OPENAI_API_KEY) hoặc "edge" (miễn phí, giọng Việt rất tự nhiên)
TTS_PROVIDER=openai

# Cấu hình OpenAI TTS (khi TTS_PROVIDER=openai)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Cấu hình Edge TTS (khi TTS_PROVIDER=edge)
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural

# Dùng OpenAI Whisper/Transcription để căn phụ đề theo từng cụm từ chính xác (true/false)
USE_WHISPER_SUBS=true
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Thông số video đầu ra (9:16 cho TikTok / Reels / Shorts)
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
TARGET_FPS=30
TARGET_MIN_SEC=40
TARGET_MAX_SEC=60
TRANSITION_SEC=0.30
BEAT_PAUSE_SEC=0.35
